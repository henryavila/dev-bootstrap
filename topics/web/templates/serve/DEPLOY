# web serve bundle (valet on mac / nginx-php-fpm on WSL) deploy mappings.
# NGINX_* / CERT_DIR / CODE_DIR / DEV_DEFAULT_PORT / PHP_DEFAULT are derived by
# ../../deploy-env.sh (sourced by the deploy driver) before envsubst runs.

# Snippets (included by site configs)
nginx-snippets/security-baseline.conf=${NGINX_SNIPPET_DIR}/mesh-security.conf
nginx-snippets/proxy-params.conf=${NGINX_SNIPPET_DIR}/mesh-proxy.conf

# Maps (auto-loaded inside http{} via conf.d)
nginx-maps/mesh-maps.conf=${NGINX_MAP_DIR}/mesh-maps.conf

# Site configs (sites-available; install creates the sites-enabled symlinks)
nginx-sites/catchall-php.conf.template=${NGINX_AVAILABLE_DIR}/catchall-php.conf
nginx-sites/catchall-proxy.conf.template=${NGINX_AVAILABLE_DIR}/catchall-proxy.conf

# User-facing CLI helper
bin/link-project.template=${HOME}/.local/bin/link-project

# Shell fragments (Laravel + service shortcuts: art, srn, srp, …)
bashrc.d-60-web-stack.sh=${HOME}/.bashrc.d/60-web-stack.sh
zshrc.d-60-web-stack.sh=${HOME}/.zshrc.d/60-web-stack.sh
