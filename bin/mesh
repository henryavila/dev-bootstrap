    local lib
    lib="$(_resolve_companion "lib/secret.sh")"
    [[ -n "$lib" ]] || _die "lib/secret.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$lib" "$@"
}

# ─── mesh setup ────────────────────────────────────────────────────
# Run the bootstrap (setup.sh) from anywhere — no `cd` into the checkout, no
# `bash setup.sh`. By default it first runs `mesh update --force` (BOTH repos)
# so the install system AND the identity (config/secrets/syncthing yaml) are
# current, THEN execs the freshly-pulled setup.sh. --force updates the current
# branch even when it is not `main` (a fleet may run a feature/release branch);
# the main-only restriction is only for the shell-start AUTO update, not this
# explicit one. (setup.sh's identity bundle also ff-pulls identity, but updating
# up-front gives a predictable clean state even if that bundle is deselected.)
# `--no-update` skips the refresh (offline / testing a local checkout). Remaining
# args pass through to setup.sh.
sub_setup() {
    local do_update=1
    local pass=()
    while (( $# > 0 )); do
        case "$1" in
            --no-update) do_update=0; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: mesh setup [--no-update] [setup.sh args...]
  Run the bootstrap from anywhere. By default runs `mesh update --force` (both
  repos, current branch) first so the install system + identity config are
  current, then runs setup.sh.
    --no-update   skip the refresh; run the current checkout's setup.sh as-is
  Extra args pass through to setup.sh (e.g. --non-interactive, --repair).
EOF
                return 0
                ;;
            --) shift; while (( $# > 0 )); do pass+=("$1"); shift; done; break ;;
            *) pass+=("$1"); shift ;;
        esac
    done

    local ws setup_sh
    ws="$(cd "$HERE/.." 2>/dev/null && pwd -P)"
    setup_sh="$ws/setup.sh"
    [[ -f "$setup_sh" ]] || _die "setup: setup.sh not found at $setup_sh"

    if (( do_update )); then
        printf 'mesh setup: refreshing both repos (mesh update --force)…\n' >&2
        # --force so a fleet on a feature/release branch (not `main`) still gets
        # pulled — `mesh setup` is explicit intent, unlike the main-only
        # shell-start auto-update. Run as a child (NOT exec) so control returns
        # here to launch setup.sh. A failed refresh (offline / dirty tree) is
        # non-fatal — fall through to the current checkout's setup.sh.
        local urc=0
        bash "${BASH_SOURCE[0]}" update --force || urc=$?
        (( urc == 0 )) || printf 'mesh setup: warning — update returned rc %d; continuing with the current checkout\n' "$urc" >&2
    fi

    printf 'mesh setup: running %s\n' "$setup_sh" >&2
    exec bash "$setup_sh" "${pass[@]+"${pass[@]}"}"
}

sub_menu() {
    local runner apply=0
    runner="$(_resolve_companion "runners/menu.sh")"
    [[ -n "$runner" ]] || _die "runners/menu.sh not found (set \$MESH_HOME or check installation)"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --apply) apply=1; shift ;;
            -h|--help)
                echo "Usage: mesh menu [--apply]"
                echo "  mesh menu          Run the interactive selector (standalone)"
                echo "  mesh menu --apply  Run selector + execute install/uninstall delta"
                return 0 ;;
            *) _die "menu: unknown arg '$1'" ;;
        esac
    done
    if (( apply )); then
        exec bash "$runner" --apply
    else
        exec bash "$runner"
    fi
}

# `mesh clean [--apply] [--deep] [--compact] [--yes]` → OS-aware disk reclaim.
# Iterates the cleaner registry (scripts/lib/cleaners/*.sh); dry-run by default.
sub_clean() {
    local runner
    runner="$(_resolve_companion "runners/clean.sh")"
    [[ -n "$runner" ]] || _die "runners/clean.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$runner" "$@"
}

# `mesh ai [term] [--agent X]` → open an AI agent in the right repo via herdr.
# Discovers repos on disk (multi-root) and hands the chosen one to herdr (focus
# if open, else create + launch). mesh-identity aliases this to `mesh ia` with
# the personal default agent + flags (see extensions/mesh.sh).
sub_ai() {
    local runner
    runner="$(_resolve_companion "runners/ia.sh")"
    [[ -n "$runner" ]] || _die "runners/ia.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$runner" "$@"
}

# `mesh services <verb> [name…]` → cross-platform service control plane.
# Curated registry of mesh-owned daemons; two orthogonal bits active × enabled.
# Verbs: list / status / start / stop / restart / enable / disable.
sub_services() {
    local runner
    runner="$(_resolve_companion "runners/services.sh")"
    [[ -n "$runner" ]] || _die "runners/services.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$runner" "$@"
}

# ─── Main dispatch ─────────────────────────────────────────────────

case "${1:-status}" in
    -h|--help)
        _print_help
        exit 0
        ;;
    -V|--version)
        echo "mesh CLI v1 (template)"
        exit 0
        ;;
    status)
        shift
        sub_status "$@"
        ;;
    snap)
        shift
        sub_snap "$@"
        ;;
    doctor)
        shift
        sub_doctor "$@"
        ;;
    adopt)
        shift
        sub_adopt "$@"
        ;;
    update)
        shift
        sub_update "$@"
        ;;
    topic)
        shift
        sub_topic "$@"
        ;;
    run)
        shift
        sub_run "$@"
        ;;
    init)
        shift
        sub_init "$@"
        ;;
    template-check)
        shift
        sub_template_check "$@"
        ;;
    lint)
        shift
        sub_lint "$@"
        ;;
    catalog)
        shift
        sub_catalog "$@"
        ;;
    personal-clone)
        shift
        sub_personal_clone "$@"
        ;;
    menu)
        shift
        sub_menu "$@"
        ;;
    setup)
        shift
        sub_setup "$@"
        ;;
    secret)
        shift
        sub_secret "$@"
        ;;
    syncthing)
        shift
        sub_syncthing "$@"
        ;;
    clean)
        shift
        sub_clean "$@"
        ;;
    ai)
        shift
        sub_ai "$@"
        ;;
    services)
        shift
        sub_services "$@"
        ;;
    --*|-*)
        # Top-level flag with no subcommand → treat as status flag.
        # Lets `mesh --json` work as shorthand for `mesh status --json`.
        sub_status "$@"
        ;;
    *)
        # Try identity-provided extension subcommand (C3).
        # Sub names may contain hyphens (e.g. mesh code-server) → map to underscores.
        extension_sub="sub_${1//-/_}"
        if declare -F "$extension_sub" >/dev/null 2>&1; then
            # shellcheck disable=SC2034  # captured for future extension dispatch
            cmd_arg="$1"
            shift
            "$extension_sub" "$@"
            exit $?
        fi
        unset extension_sub cmd_arg
        printf 'mesh: unknown subcommand %q\n\n' "$1" >&2
        _print_help >&2
        exit 1
        ;;
esac
