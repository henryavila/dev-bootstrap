#!/usr/bin/env bash
# bin/mesh — unified dispatcher for the mesh ecosystem.
#
# Replaces the older quartet `bup` / `dotup` / `mesh-snap` / `mesh-status`
# with a single command. Subcommands delegate to the underlying motors:
#
#   mesh status [<alias>] [flags]            →  scripts/internal/mesh-status (positional → --detail)
#   mesh snap   [flags]                      →  scripts/internal/mesh-snap   (passthrough)
#   mesh update [-o NAME] [-f] [-i] [flags]  →  scripts/runners/auto-update.sh  (--only / --full / --interactive)
#   mesh topic list|<numbers...>             →  mesh-workstation topic list / topic-only apply
#   mesh run [flags] <subcommand> [args]     →  selected hosts, sequential over SSH
#
# Bare `mesh` (no subcommand) renders the cross-mesh dashboard (= `mesh status`).
#
# Spec: docs/2026-05-02-mesh-cli-refactor-spec.md
# Bash 3.2 compatible (macOS default).

set -uo pipefail

# ─── Symlink canonicalization (bash 3.2 / BSD readlink portable) ───
# `mesh` is invoked via `~/.local/bin/mesh` (symlink installed by
# setup.sh). Plain `dirname "${BASH_SOURCE[0]}"` returns the symlink's
# directory, which makes tier 2 of `_resolve_companion` resolve to
# `~/.local/scripts/` (does not exist). Canonicalize first so $HERE
# anchors to the workstation checkout regardless of how mesh was
# invoked. macOS bash 3.2 has no `realpath`/`readlink -f`, so we
# resolve symlinks in a loop with BSD `readlink` (single-level).
_canonicalize() {
    local p="$1" target
    while [[ -L "$p" ]]; do
        target="$(readlink "$p")"
        if [[ "$target" = /* ]]; then
            p="$target"
        else
            p="$(cd "$(dirname "$p")" && pwd -P)/$target"
        fi
    done
    printf '%s' "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}

HERE="$(cd "$(dirname "$(_canonicalize "${BASH_SOURCE[0]}")")" && pwd -P)"

# ─── Companion resolution ──────────────────────────────────────────
# 3-tier lookup for the lib + motor scripts that this dispatcher
# delegates to. Solves the deploy-time path puzzle: $HERE = .../bin/
# which has no companions; companions live in ../scripts/.
#
# Tier order:
#   1. $MESH_HOME (env override; test fixtures, manual relocation)
#   2. $HERE/../scripts/<target> (development tree; bin/mesh sibling)
#
# Returns absolute path on stdout; empty on miss.
_resolve_companion() {
    local target="$1"
    if [[ -n "${MESH_HOME:-}" ]] && { [[ -d "$MESH_HOME/$target" ]] || [[ -f "$MESH_HOME/$target" ]]; }; then
        echo "$MESH_HOME/$target"
        return
    fi
    local dev_target="$HERE/../scripts/$target"
    if [[ -d "$dev_target" ]] || [[ -f "$dev_target" ]]; then
        echo "$dev_target"
        return
    fi
    echo ""
}

_die() {
    printf 'mesh: %s\n' "$*" >&2
    exit 1
}

# ─── Command registry kernel ───────────────────────────────────────

_mesh_load_command_registry() {
    local registry
    registry="$(_resolve_companion "lib/mesh-command.sh")"
    [[ -n "$registry" ]] || _die "lib/mesh-command.sh not found (set \$MESH_HOME or check installation)"
    # shellcheck disable=SC1090
    . "$registry"
}
_mesh_load_command_registry

# ─── Extension hook (C3) ───────────────────────────────────────────
# Source identity-side extensions if present, after sourcing env.sh to
# populate MESH_IDENTITY_DIR. Extensions may define `sub_<name>`
# functions that the dispatcher will route to via the case fallthrough
# below. Non-fatal if either file is absent or unreadable.
_mesh_load_extensions() {
    local env_lib ext
    env_lib="$(_resolve_companion lib/env.sh)"
    if [[ -n "$env_lib" && -r "$env_lib" ]]; then
        # shellcheck disable=SC1090
        . "$env_lib"
    fi
    ext="${MESH_IDENTITY_DIR:-$HOME/mesh-identity}/extensions/mesh.sh"
    if [[ -r "$ext" ]]; then
        # shellcheck disable=SC1090
        . "$ext"
    fi
}
_mesh_load_extensions

# ─── Help ──────────────────────────────────────────────────────────

_mesh_print_public_command_table() {
    local name summary _group _origin _visibility _fanout
    mesh_command_emit_tsv | while IFS=$'\t' read -r name summary _group _origin _visibility _fanout; do
        [[ -n "$name" ]] || continue
        printf '  %-22s %s\n' "$name" "$summary"
    done
}

_print_help() {
    cat <<'EOF'
Mesh CLI — unified entrypoint for ecosystem maintenance.

Usage:
  mesh                              Show cross-mesh status panel (= mesh status)
  mesh <command> [args...]          Run a registered mesh command
  mesh help [command]               Browse command help
  mesh -h | --help                  Open interactive help on a TTY; plain help otherwise
  mesh -V | --version               Version

Commands:
EOF
    _mesh_print_public_command_table
    cat <<'EOF'

Help:
  mesh help                         Interactive command browser
  mesh help <command>               Open help focused on one command
  mesh help --plain                 Print this compact help
  mesh <command> --help             Print detailed help for one command
EOF
}

_normalize_topic_spec() {
    local raw="$*"
    raw="${raw//,/ }"
    # shellcheck disable=SC2086
    set -- $raw
    printf '%s' "$*"
}

_resolve_workstation_repo() {
    if [[ -n "${MESH_WORKSTATION_DIR:-}" && -d "$MESH_WORKSTATION_DIR/topics" ]]; then
        printf '%s\n' "$MESH_WORKSTATION_DIR"
        return 0
    fi
    if [[ -d "$HERE/../topics" ]]; then
        printf '%s\n' "$( cd "$HERE/.." && pwd -P )"
        return 0
    fi
    if [[ -d "$HOME/mesh-workstation/topics" ]]; then
        printf '%s\n' "$HOME/mesh-workstation"
        return 0
    fi
    return 1
}

sub___commands() {
    case "${1:-}" in
        "")
            mesh_command_emit_tsv
            ;;
        --all)
            mesh_command_emit_tsv --all
            ;;
        --internal)
            mesh_command_emit_tsv --internal
            ;;
        -h|--help)
            cat <<'EOF'
Usage:
  mesh __commands             Emit public command metadata as TSV.
  mesh __commands --all       Include public and hidden commands.
  mesh __commands --internal  Include public, hidden, and internal commands.

Columns: name, summary, group, origin, visibility, fanout.
EOF
            ;;
        *)
            _die "__commands: unknown arg '$1' (expected --all or --internal)"
            ;;
    esac
}

# ─── Main dispatch ─────────────────────────────────────────────────

_mesh_load_command_modules() {
    local specs="" dir file old_ifs identity_command_dir
    if [[ -n "${MESH_COMMAND_MODULE_DIR:-}" ]]; then
        specs="$MESH_COMMAND_MODULE_DIR"
    fi
    if [[ -n "${MESH_COMMAND_MODULE_DIRS:-}" ]]; then
        specs="${specs:+$specs:}$MESH_COMMAND_MODULE_DIRS"
    fi
    if [[ -d "$HERE/../scripts/commands" ]]; then
        specs="${specs:+$specs:}$HERE/../scripts/commands"
    fi
    identity_command_dir="${MESH_IDENTITY_DIR:-$HOME/mesh-identity}/extensions/mesh/commands"
    if [[ -d "$identity_command_dir" ]]; then
        specs="${specs:+$specs:}$identity_command_dir"
    fi

    old_ifs="$IFS"
    IFS=:
    for dir in $specs; do
        [[ -n "$dir" && -d "$dir" ]] || continue
        for file in "$dir"/*.sh; do
            [[ -e "$file" ]] || continue
            _MESH_COMMAND_REGISTRY_ERROR=0
            # shellcheck disable=SC1090
            if ! . "$file" || [[ "${_MESH_COMMAND_REGISTRY_ERROR:-0}" == "1" ]]; then
                _MESH_COMMAND_REGISTRY_ERROR=0
                IFS="$old_ifs"
                _die "command module failed to load: $file"
            fi
            _MESH_COMMAND_REGISTRY_ERROR=0
        done
    done
    IFS="$old_ifs"
}

_mesh_register_internal_command_list() {
    if mesh_command_registered "__commands"; then
        return 0
    fi
    mesh_register_command \
        --name "__commands" \
        --summary "Emit command metadata TSV" \
        --group core \
        --origin core \
        --visibility internal \
        --fanout none \
        --handler sub___commands || _die "failed to register internal command: __commands"
}

_mesh_dispatch_private_fallback() {
    local extension_sub="sub_${1//-/_}"
    if declare -F "$extension_sub" >/dev/null 2>&1; then
        # shellcheck disable=SC2034  # captured for future extension dispatch
        cmd_arg="$1"
        shift
        "$extension_sub" "$@"
        exit $?
    fi
    unset extension_sub cmd_arg
    return 1
}

_mesh_dispatch() {
    if [[ "$#" -eq 0 ]]; then
        set -- status
    fi

    local command_name handler status_handler
    case "${1:-}" in
        -h|--help)
            if [[ "${MESH_HELP_PLAIN:-0}" != "1" && -t 0 && -t 1 ]]; then
                handler="$(mesh_command_get help handler 2>/dev/null || true)"
                if [[ -n "$handler" ]]; then
                    "$handler"
                    exit $?
                fi
            fi
            _print_help
            exit 0
            ;;
        -V|--version)
            echo "mesh CLI v1 (template)"
            exit 0
            ;;
        --*|-*)
            # Top-level flag with no subcommand → treat as status flag.
            # Lets `mesh --json` run as shorthand for `mesh status --json`.
            status_handler="$(mesh_command_get status handler)" || _die "registered command has no handler: status"
            "$status_handler" "$@"
            exit $?
            ;;
    esac

    command_name="$1"
    if mesh_command_registered "$command_name"; then
        handler="$(mesh_command_get "$command_name" handler)" || _die "registered command has no handler: $command_name"
        shift
        "$handler" "$@"
        exit $?
    fi

    if _mesh_dispatch_private_fallback "$@"; then
        exit $?
    fi

    printf 'mesh: unknown subcommand %q\n\n' "$command_name" >&2
    _print_help >&2
    exit 1
}

_mesh_load_command_modules
_mesh_register_internal_command_list
_mesh_dispatch "$@"
