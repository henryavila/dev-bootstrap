#!/usr/bin/env bash
# bin/mesh — unified dispatcher for the mesh ecosystem.
#
# Replaces the older quartet `bup` / `dotup` / `mesh-snap` / `mesh-status`
# with a single command. Subcommands delegate to the underlying motors:
#
#   mesh status [<alias>] [flags]            →  scripts/internal/mesh-status (positional → --detail)
#   mesh snap   [flags]                      →  scripts/internal/mesh-snap   (passthrough)
#   mesh update [-o NAME] [-f] [-i] [flags]  →  scripts/runners/auto-update.sh  (--only / --full / --interactive)
#   mesh topic list|<numbers...>             →  mesh-workstation topic list / topic-only apply
#   mesh run [flags] <subcommand> [args]     →  selected hosts, sequential over SSH
#
# Bare `mesh` (no subcommand) renders the cross-mesh dashboard (= `mesh status`).
#
# Spec: docs/2026-05-02-mesh-cli-refactor-spec.md
# Bash 3.2 compatible (macOS default).

set -uo pipefail

# ─── Symlink canonicalization (bash 3.2 / BSD readlink portable) ───
# `mesh` is invoked via `~/.local/bin/mesh` (symlink installed by
# setup.sh). Plain `dirname "${BASH_SOURCE[0]}"` returns the symlink's
# directory, which makes tier 2 of `_resolve_companion` resolve to
# `~/.local/scripts/` (does not exist). Canonicalize first so $HERE
# anchors to the workstation checkout regardless of how mesh was
# invoked. macOS bash 3.2 has no `realpath`/`readlink -f`, so we
# resolve symlinks in a loop with BSD `readlink` (single-level).
_canonicalize() {
    local p="$1" target
    while [[ -L "$p" ]]; do
        target="$(readlink "$p")"
        if [[ "$target" = /* ]]; then
            p="$target"
        else
            p="$(cd "$(dirname "$p")" && pwd -P)/$target"
        fi
    done
    printf '%s' "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}

HERE="$(cd "$(dirname "$(_canonicalize "${BASH_SOURCE[0]}")")" && pwd -P)"

# ─── Companion resolution ──────────────────────────────────────────
# 3-tier lookup for the lib + motor scripts that this dispatcher
# delegates to. Solves the deploy-time path puzzle: $HERE = .../bin/
# which has no companions; companions live in ../scripts/.
#
# Tier order:
#   1. $MESH_HOME (env override; test fixtures, manual relocation)
#   2. $HERE/../scripts/<target> (development tree; bin/mesh sibling)
#
# Returns absolute path on stdout; empty on miss.
_resolve_companion() {
    local target="$1"
    if [[ -n "${MESH_HOME:-}" ]] && { [[ -d "$MESH_HOME/$target" ]] || [[ -f "$MESH_HOME/$target" ]]; }; then
        echo "$MESH_HOME/$target"
        return
    fi
    local dev_target="$HERE/../scripts/$target"
    if [[ -d "$dev_target" ]] || [[ -f "$dev_target" ]]; then
        echo "$dev_target"
        return
    fi
    echo ""
}

_die() {
    printf 'mesh: %s\n' "$*" >&2
    exit 1
}

# ─── Extension hook (C3) ───────────────────────────────────────────
# Source identity-side extensions if present, after sourcing env.sh to
# populate MESH_IDENTITY_DIR. Extensions may define `sub_<name>`
# functions that the dispatcher will route to via the case fallthrough
# below. Non-fatal if either file is absent or unreadable.
_mesh_load_extensions() {
    local env_lib ext
    env_lib="$(_resolve_companion lib/env.sh)"
    if [[ -n "$env_lib" && -r "$env_lib" ]]; then
        # shellcheck disable=SC1090
        . "$env_lib"
    fi
    ext="${MESH_IDENTITY_DIR:-$HOME/mesh-identity}/extensions/mesh.sh"
    if [[ -r "$ext" ]]; then
        # shellcheck disable=SC1090
        . "$ext"
    fi
}
_mesh_load_extensions

# ─── Help ──────────────────────────────────────────────────────────

_print_help() {
    cat <<'EOF'
Mesh CLI — unified entrypoint for ecosystem maintenance.

Usage:
  mesh                              Show cross-mesh status panel (= mesh status)
  mesh status [<alias>] [flags]     Cross-mesh dashboard; positional drill-down
  mesh snap [flags]                 Generate this host's snapshot
  mesh doctor [--fix]               Report deploy drift; --fix repairs broken installed items
  mesh adopt                        Backfill install markers for already-present tools (v1→v2; read-only)
  mesh update [-o NAME] [-f] [-i]   Pull and apply updates
  mesh setup [--no-update]          Update both repos, then run setup.sh
  mesh topic list                   List mesh-workstation topics
  mesh topic <NN...>                Re-apply mesh-workstation topics by number
  mesh run [flags] <subcommand>     Run mesh subcommands on selected hosts
  mesh lint                         Run repo invariant lints (scripts/lib/lints/L*.sh)
  mesh catalog generate             Regenerate .catalog/ derived listings
  mesh init [MODE | FLAGS]          Bootstrap identity (adopt-url/create-new/skip/interactive)
  mesh template-check [flags]       Verify template/ ↔ identity parity (C16.1)
  mesh personal-clone [flags]       Clone personal repos from identity catalog
  mesh menu [--apply]               Interactive item selector (standalone or with apply)
  mesh secret <verb>                Manage replicated personal secrets (git-crypt 2-tier)
  mesh syncthing <verb>             Pair this node into the Syncthing mesh (pair/init-hub/status/password/url)
  mesh clean [--apply] [--deep]     Reclaim disk: purge regenerable dev caches (dry-run default); --compact (WSL) shrinks the VHDX
  mesh ai [term] [--agent X]        Open an AI agent in the right repo via herdr (disk-search + focus-or-create)
  mesh services <verb> [name…]      Control mesh-owned daemons (list/status/start/stop/restart/enable/disable) — active × enabled
  mesh -h | --help                  This help
  mesh -V | --version               Version

Subcommands:
  status   View cross-mesh state. `mesh status crc` → drill-down on host 'crc'.
           Run `mesh status -h` for flags (--detail, --write, --json, --refresh, …).
  snap     Refresh this host's snapshot. Hooks call this automatically;
           rarely run by hand. `mesh snap -h` for flags.
  update   Pull commits and re-apply install scripts for one or both repos.
           Default scope (no -o) = both repos sequentially. Default mode = incremental.

           Flags (lowercase short, GNU long, both accepted):
             -o, --only NAME         Restrict to NAME (mesh-workstation | mesh-identity).
                                     Aliases: workstation, identity.
             -f, --full              Full apply (runs setup.sh / install.sh
                                     instead of incremental diff replay).
             -i, --interactive       In `-f` + mesh-workstation, run setup.sh
                                     WITHOUT --non-interactive (i.e. show the menu).
                                     Silently ignored for mesh-identity or incremental runs.
                 --force             Update the CURRENT branch even if it is not
                                     `main` (the shell-start auto-update stays
                                     main-only). For a fleet on a feature/release
                                     branch. Still refuses on a dirty tree or
                                     unpushed local commits.

           Passthrough flags: --reset-auth, --from-shell-start.
  setup    Run the bootstrap (setup.sh) from any directory. Runs `mesh update`
           (both repos) first so the install system AND the identity config
           (secrets, syncthing yaml, dotfiles) are current, then runs setup.sh.
           `--no-update` skips the refresh; remaining args pass through to setup.sh.
  doctor   Health check. No args: report identity deploy drift + system
           phantoms (read-only, the existing deploy-drift doctor). `--fix`:
           run the engine's verify+repair sweep over every INSTALLED item —
           it runs each item's strongest probe (not the weak keep/skip check)
           and repairs broken-but-kept ones THROUGH the installer (e.g. `brew
           reinstall` a formula whose dylib a dependency bump removed, or
           re-run `valet install` on a dead serving stack). No manual fixes.
           Exit 0 = healthy/repaired, 67 = item(s) left unresolved.
  adopt    Read-only install-marker backfill for a machine provisioned by the
           older v1 system (tools present, zero v2 markers → the marker-only
           setup menu wrongly shows everything "not installed"). Runs each
           item's strongest probe and writes the marker for every ALREADY-
           present item, WITHOUT install/deploy/sudo. Idempotent + safe to
           re-run; an absent tool gets no marker. The read-only sibling of
           `doctor --fix` for the inverse (marker-absent) drift.
  topic    Convenience wrapper for mesh-workstation topics. `mesh topic list`
           prints the topic numbers from the local mesh-workstation checkout.
           `mesh topic 20 30` runs only those topics, equivalent to
           `mesh update -o workstation --topics 20,30`.

  run      Fan out a mesh subcommand to selected hosts. Default mode opens
           a multi-select with all online hosts preselected when fzf/whiptail
           is available. Remote hosts run sequentially through `ssh -tt`, so
           password/sudo prompts happen one machine at a time. Local host
           selection runs locally.

           Flags:
             --hosts A,B             Automation mode: exact configured aliases.
             --online                Run on online configured hosts, no selector.
             --all                   Run on all configured hosts, no selector.
             --dry-run               Show what would run, execute nothing.

           Supported remote subcommands: status, snap, update.
           `mesh run update ... -i` is intentionally rejected; interactive
           update menus belong on one host at a time.

  lint     Run the repo invariant lint suite (scripts/lib/lints/L*.sh).
           Each lint checks one architectural rule (no hardcoded paths,
           bash 3.2 compat, marker case-insensitivity, etc.). Exit code
           equals the number of failing lints. Run on a clean tree before
           pushing; CI runs the same suite.

  init     Bootstrap identity on a fresh machine. 4 modes (C13.2):
             adopt-url <URL> | --identity-repo <URL>   clone existing identity
             create-new      | --create-identity      scaffold from template/
             skip            | --no-identity          workstation only
             interactive     | (no arg, TTY)          whiptail prompt menu
           Idempotent: existing $MESH_IDENTITY_DIR ⇒ no-op exit 0.
           Run `mesh init -h` for the full flag list.

  template-check  Verify mesh-workstation/template/ ↔ mesh-identity structural
           parity (C16.1). Exit 0 = parity, 1 = drift. Flags:
             --quiet         exit code only; no output (used by pre-commit hook)
             --install-hook  write $MESH_IDENTITY_DIR/.git/hooks/pre-commit
           Skip namespaces (no parity required, both directions):
             .git/, tests/, docs/, .ai/memory/, claude/, .claude/, npm/
             codex/config.toml, git/gitconfig.local,
             ssh/authorized_keys, ssh/config

  catalog  Regenerate the .catalog/ derived listings (topic/item inventory the
           menu + status surfaces read) from the live mesh-workstation tree.
           `mesh catalog generate` rebuilds them. Run after adding/renaming topics.

  personal-clone  Clone your personal repos from the mesh-identity catalog onto
           this machine — reads the identity repo list and clones any missing.
           `mesh personal-clone -h` for flags.

  menu     Interactive item selector (the Ink TUI). `mesh menu` runs the
           selector standalone (writes your selection); `mesh menu --apply`
           runs the selector then executes the install/uninstall delta.

  secret   Manage replicated personal secrets (git-crypt 2-tier). Verbs:
             init             first machine: install+init git-crypt, write the
                              .gitattributes rule, export the root key.
             unlock <keyfile> new machine: decrypt the repo with the key.
             add              wizard: add an integration (login | file | token).
             set <id>         update a stored value.
             rm <id>          remove an integration.
             list             integrations + per-machine + replication status.
             doctor           drift / health checks.
             deploy           decrypt+place all enabled Tier-2 files; run logins.
             push             push pending commits (after a failed auto-push).
           add/set/rm commit AND push — "saved" means "replicated".

  syncthing  Pair this node into the Syncthing mesh — declarative reconcile from
           identity sync/syncthing-mesh.yaml. Verbs:
             pair               idempotent reconcile from syncthing-mesh.yaml.
             init-hub [--write] first-hub bootstrap: print this node's id + the
                                ready-to-paste snippet (--write updates the file).
                                Asks star vs mesh and writes the topology for you
                                (or --topology star|mesh, non-interactive).
             topology [star|mesh]  show or switch the mesh-wide topology.
             status             live convergence summary (peers + folders).
             password [--reset] show GUI login state; --reset rotates via the API
                                key + prints the new password (recovery path).
             url                print the admin UI URL.

  clean    Reclaim disk space across mac / WSL / native Linux. Iterates a
           registry of per-tool cleaner modules (scripts/lib/cleaners/*.sh),
           each self-gated by OS + tool presence. DRY-RUN by default (lists
           reclaimable caches, deletes nothing). Flags:
             --apply    purge Tier-1 caches (npm/pip/uv/composer/apt/journal/
                        JetBrains/… — regenerable, no re-download cost).
             --deep     also purge Tier-2 (Playwright/Puppeteer browsers,
                        torch/HuggingFace model caches — re-downloaded on use).
             --compact  WSL only: the ext4.vhdx never auto-shrinks, so this
                        hands off the Windows-side `wsl --shutdown` +
                        `wsl --manage <distro> --set-sparse true` that returns
                        freed space to C: (no-op off-WSL).
             --yes/-y   skip the --apply confirmation (for automation).
           Never deletes source, venvs, secrets, or ~/.local/share data.

  ai       Open an AI agent in the right repo via herdr (the agent multiplexer).
           Discovers repos one level under each root in $IA_ROOTS (default per OS
           — mac: /Volumes/External/Code + ~; WSL/Linux: $CODE_DIR + ~), then:
             • a <term> that matches exactly one repo opens it directly;
             • no term / an ambiguous term → a searchable picker listing open
               herdr workspaces (focus) above discoverable repos (create);
             • routing: an open workspace → `herdr workspace focus`; a repo →
               `herdr workspace create --cwd … --label …` + launch the agent.
           Flags:
             --agent X  use claude|codex|gemini for this run (remembered per
                        project; default + personal flags come from mesh-identity).
             --list     print the discovered catalogue and exit (no launch).
           mesh-identity aliases this to `mesh ia` with claude + its own flags.

Examples:
  mesh                              Open the panel
  mesh status crc                   Drill-down on host 'crc'
  mesh status --write               Refresh §3 of PROJECT_STATUS.md
  mesh update                       Both repos, incremental
  mesh update -f                    Both repos, full apply
  mesh update -o workstation         Only mesh-workstation, incremental
  mesh update -o workstation -f     Only mesh-workstation, full (non-interactive)
  mesh update -o workstation -f -i  Only mesh-workstation, full, with interactive menu
  mesh update -o identity           Only mesh-identity, incremental
  mesh topic list                   Show official mesh-workstation topic numbers
  mesh topic 20 30                  Re-apply terminal UX + shell topics
  mesh run update -f                Select hosts, then run mesh update -f
  mesh run --hosts mac,crc update -f
  mesh run --online snap --quiet
  mesh run --all syncthing pair    Reconcile the Syncthing mesh on every host
  mesh init --create-identity      Scaffold new mesh-identity from template/
  mesh init --identity-repo URL    Adopt existing identity by URL
  mesh template-check              Check template/ ↔ identity parity
  mesh template-check --install-hook
                                   Install pre-commit hook in mesh-identity
  mesh menu --apply                Pick items, then install/uninstall the delta
  mesh secret add                  Add an integration (login | file | token)
  mesh secret deploy               Place all enabled Tier-2 secret files
  mesh syncthing pair              Reconcile this node into the Syncthing mesh
  mesh syncthing status            Show peer + folder convergence
  mesh clean                       Dry-run: what dev caches can be reclaimed
  mesh clean --apply               Purge Tier-1 caches
  mesh clean --apply --deep        Also purge heavy browser/model caches
  mesh clean --apply --deep --compact   Full reclaim, then shrink the WSL VHDX
  mesh services list               List mesh-owned daemons with active/enabled badges
  mesh services stop mysql redis   Stop both now (does not change boot state)
  mesh services disable mysql      Stop mysql from starting at boot (leaves it running)

Configuration:
  ~/.config/mesh/mesh-status.conf       (alias map, run hosts, repos tracked, retention)
  ~/.config/mesh/config.env             (per-host config: repo paths, auto-update repos)

Spec: docs/2026-05-02-mesh-cli-refactor-spec.md
EOF
}

# ─── Subcommand handlers ───────────────────────────────────────────

sub_status() {
    local lib
    lib="$(_resolve_companion "internal/mesh-status")"
    [[ -n "$lib" ]] || _die "internal/mesh-status not found (set \$MESH_HOME or check installation)"

    # First non-flag arg becomes positional alias → translates to --detail.
    # If first arg is a flag (or no args), pass through as-is.
    local first="${1:-}"
    case "$first" in
        --*|-*|"")
            exec "$lib" "$@"
            ;;
        *)
            local alias_arg="$1"
            shift
            exec "$lib" --detail "$alias_arg" "$@"
            ;;
    esac
}

sub_snap() {
    local lib
    lib="$(_resolve_companion "internal/mesh-snap")"
    [[ -n "$lib" ]] || _die "internal/mesh-snap not found (set \$MESH_HOME or check installation)"
    exec "$lib" "$@"
}

# `mesh doctor`        → identity deploy-drift + system-phantom report (read-only).
# `mesh doctor --fix`  → engine --repair sweep: verify every INSTALLED item with
#   its strongest probe and repair broken-but-kept ones THROUGH the installer
#   (e.g. `brew reinstall` a formula whose dylib a dependency bump removed, or
#   re-run `valet install` on a dead serving stack). rc 0 healthy/repaired, 67
#   unresolved. (verify/operational plan §C — no manual fixes.)
sub_doctor() {
    local fix=0
    local passthrough=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --fix) fix=1; shift ;;
            -h|--help)
                cat <<'EOF'
Usage:
  mesh doctor            Report identity deploy drift + system phantoms (read-only).
  mesh doctor --fix      Verify every installed item's strongest probe and REPAIR
                         broken-but-installed items through the installer (engine
                         --repair). Reinstalls a brew formula whose dylib a
                         dependency bump removed, restarts a dead valet stack, etc.
                         rc 0 = healthy/repaired, 67 = unresolved.
EOF
                return 0 ;;
            *) passthrough+=("$1"); shift ;;
        esac
    done
    if [[ "$fix" -eq 1 ]]; then
        local repo
        repo="$(_resolve_workstation_repo)" || \
            _die "mesh-workstation repo not found (set MESH_WORKSTATION_DIR) — needed for doctor --fix"
        exec bash "$repo/setup.sh" --repair "${passthrough[@]+"${passthrough[@]}"}"
    fi
    local runner
    runner="$(_resolve_companion "runners/doctor.sh")"
    [[ -n "$runner" ]] || _die "runners/doctor.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$runner" "${passthrough[@]+"${passthrough[@]}"}"
}

# `mesh adopt` → READ-ONLY install-marker backfill (setup.sh --adopt → engine
# --adopt). A machine provisioned by the older v1 system has the tools but zero
# v2 install markers, so the v2 setup menu shows every bundle as "not installed"
# (false negative — the menu reads markers only). `mesh adopt` runs each item's
# strongest probe and writes the marker for every item that is ALREADY present,
# WITHOUT install/deploy/sudo. Idempotent + safe to re-run; an absent tool gets
# no marker. (scanner-marker-coherence handoff §A.)
sub_adopt() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat <<'EOF'
Usage:
  mesh adopt     Read-only: for every tool already installed but missing its
                 mesh install marker (e.g. a machine set up by the older v1
                 system), write the marker WITHOUT running any install/deploy/
                 sudo. Makes the setup menu show the true install state.
                 Idempotent + safe to re-run; an absent tool gets no marker.
EOF
                return 0 ;;
            *) _die "adopt: unexpected arg '$1' (mesh adopt takes no arguments)" ;;
        esac
    done
    local repo
    repo="$(_resolve_workstation_repo)" || \
        _die "mesh-workstation repo not found (set MESH_WORKSTATION_DIR) — needed for adopt"
    exec bash "$repo/setup.sh" --adopt
}

# `mesh syncthing <verb>` → REST-driven Syncthing mesh pairing (workstation
# runner). Replaces the old passive post-install banner: a declarative reconcile
# from the identity syncthing-mesh.yaml (pair/init-hub/status/password/url).
sub_syncthing() {
    local runner
    runner="$(_resolve_companion "runners/syncthing.sh")"
    [[ -n "$runner" ]] || _die "runners/syncthing.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$runner" "$@"
}

_normalize_topic_spec() {
    local raw="$*"
    raw="${raw//,/ }"
    # shellcheck disable=SC2086
    set -- $raw
    printf '%s' "$*"
}

_resolve_workstation_repo() {
    if [[ -n "${MESH_WORKSTATION_DIR:-}" && -d "$MESH_WORKSTATION_DIR/topics" ]]; then
        printf '%s\n' "$MESH_WORKSTATION_DIR"
        return 0
    fi
    if [[ -d "$HERE/../topics" ]]; then
        printf '%s\n' "$( cd "$HERE/.." && pwd -P )"
        return 0
    fi
    if [[ -d "$HOME/mesh-workstation/topics" ]]; then
        printf '%s\n' "$HOME/mesh-workstation"
        return 0
    fi
    return 1
}

_print_topic_help() {
    cat <<'EOF'
Usage:
  mesh topic list
  mesh topic <NN|NN-name> [...]

Examples:
  mesh topic list
  mesh topic 20 30
  mesh topic 20-terminal-ux 30-shell
EOF
}

sub_topic() {
    case "${1:-}" in
        -h|--help|"")
            _print_topic_help
            return 0
            ;;
        list)
            shift
            (( $# == 0 )) || _die "topic list: unexpected arg '$1'"
            local repo
            repo="$(_resolve_workstation_repo)" || \
                _die "mesh-workstation repo not found (set MESH_WORKSTATION_DIR)"
            exec bash "$repo/setup.sh" --list-bundles
            ;;
    esac

    local topics
    topics="$(_normalize_topic_spec "$@")"
    [[ -n "$topics" ]] || _die "topic: missing topic number"
    sub_update --topics "$topics"
}

sub_update() {
    export DEV_BOOTSTRAP_TMUX_AUTO_MAIN=0

    local motor
    motor="$(_resolve_companion "runners/auto-update.sh")"
    [[ -n "$motor" ]] || _die "runners/auto-update.sh not found (set \$MESH_HOME or check installation)"

    if (( $# == 1 )) && [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        exec bash "$motor" --help
    fi

    # Flags forwarded to the motor verbatim. `-o NAME` / `--only NAME` is
    # extracted into $only because we use it both for single-target dispatch
    # and (when empty) for the both-repos fallback below.
    local only=""
    local topics_spec=""
    local full=0
    local interactive=0
    local pass_args=()
    while (( $# > 0 )); do
        case "$1" in
            -o|--only)
                shift
                local val="${1:-}"
                if [[ -z "$val" || "$val" == -* ]]; then
                    _die "update: -o/--only requires a repo name (mesh-workstation | mesh-identity)"
                fi
                case "$val" in
                    workstation) val="mesh-workstation" ;;
                    identity)   val="mesh-identity" ;;
                esac
                only="$val"
                shift
                ;;
            -t|--topics)
                shift
                local val="${1:-}"
                if [[ -z "$val" || "$val" == -* ]]; then
                    _die "update: -t/--topics requires a topic number or name"
                fi
                topics_spec="$topics_spec $val"
                shift
                ;;
            --topics=*)
                local val="${1#*=}"
                [[ -n "$val" ]] || _die "update: --topics requires a topic number or name"
                topics_spec="$topics_spec $val"
                shift
                ;;
            -f|--full)         full=1; pass_args+=("--full");        shift ;;
            -i|--interactive)  interactive=1; pass_args+=("--interactive"); shift ;;
            --*|-*)            pass_args+=("$1");            shift ;;
            *)
                _die "update: unknown arg '$1' (expected -o NAME | -f | -i | -t TOPICS | passthrough flag)"
                ;;
        esac
    done

    if [[ -n "$topics_spec" ]]; then
        (( interactive == 0 )) || _die "update: --topics cannot be combined with -i/--interactive"
        if [[ -n "$only" && "$only" != "mesh-workstation" ]]; then
            _die "update: --topics applies only to mesh-workstation"
        fi
        only="mesh-workstation"
        topics_spec="$(_normalize_topic_spec "$topics_spec")"
        [[ -n "$topics_spec" ]] || _die "update: --topics requires a topic number or name"
        if (( full == 0 )); then
            pass_args+=("--full")
        fi
        export ONLY_TOPICS="$topics_spec"
        export DEV_BOOTSTRAP_REQUIRE_ONLY_TOPICS=1
    fi

    if [[ -n "$only" ]]; then
        exec bash "$motor" --only "$only" "${pass_args[@]+"${pass_args[@]}"}"
    fi

    # No -o/--only — run both sequentially. Exit code = OR of both rc (any
    # failure surfaces; user can see which via output). Bash 3.2 safe array
    # expansion.
    local ws_rc=0 id_rc=0
    bash "$motor" --only mesh-workstation "${pass_args[@]+"${pass_args[@]}"}"
    ws_rc=$?
    bash "$motor" --only mesh-identity "${pass_args[@]+"${pass_args[@]}"}"
    id_rc=$?
    exit $(( ws_rc | id_rc ))
}

# ─── mesh run helpers ──────────────────────────────────────────────

_run_config_is_array() {
    declare -p "$1" 2>/dev/null | grep -q 'declare \-[^ ]*a'
}

_load_mesh_run_config() {
    local conf="${MESH_STATUS_CONF:-$HOME/.config/mesh/mesh-status.conf}"
    if [[ -r "$conf" ]]; then
        # shellcheck source=/dev/null
        . "$conf" 2>/dev/null || true
    fi

    if ! _run_config_is_array MESH_RUN_HOSTS; then
        MESH_RUN_HOSTS=("ultron=ultron-wsl" "mac=mac" "crc=crc")
    fi
}

_lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

_first_label() {
    local name="$1"
    name="${name%%.*}"
    printf '%s' "$name"
}

_mesh_alias_for_name() {
    local name="$1"
    local key mapped
    key="$(_first_label "$name")"

    if [[ -n "${MESH_TAILSCALE_ALIAS_MAP:-}" ]] && command -v jq >/dev/null 2>&1; then
        mapped=$(jq -er --arg k "$key" '.[$k] // empty' <<<"$MESH_TAILSCALE_ALIAS_MAP" 2>/dev/null) && {
            printf '%s' "$mapped"
            return
        }
        mapped=$(jq -er --arg k "$(_lower "$key")" '.[$k] // empty' <<<"$MESH_TAILSCALE_ALIAS_MAP" 2>/dev/null) && {
            printf '%s' "$mapped"
            return
        }
    fi

    printf '%s' "$key"
}

RUN_HOST_ALIASES=()
RUN_HOST_TARGETS=()
RUN_ONLINE_ALIASES=()
RUN_SELECTED_ALIASES=()
RUN_SELECTED_TARGETS=()

_mesh_load_run_hosts() {
    _load_mesh_run_config
    RUN_HOST_ALIASES=()
    RUN_HOST_TARGETS=()

    local spec alias target
    for spec in "${MESH_RUN_HOSTS[@]+"${MESH_RUN_HOSTS[@]}"}"; do
        [[ -n "$spec" ]] || continue
        if [[ "$spec" == *=* ]]; then
            alias="${spec%%=*}"
            target="${spec#*=}"
        else
            alias="$spec"
            target="$spec"
        fi
        [[ -n "$alias" && -n "$target" ]] || _die "run: invalid MESH_RUN_HOSTS entry '$spec'"
        RUN_HOST_ALIASES+=("$alias")
        RUN_HOST_TARGETS+=("$target")
    done

    (( ${#RUN_HOST_ALIASES[@]} > 0 )) || _die "run: no hosts configured in MESH_RUN_HOSTS"
}

_mesh_known_hosts_display() {
    local i out=""
    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        out="${out:+$out, }${RUN_HOST_ALIASES[$i]}"
    done
    printf '%s' "$out"
}

_mesh_find_host_index() {
    local wanted="$1"
    local i
    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        if [[ "$wanted" == "${RUN_HOST_ALIASES[$i]}" || "$wanted" == "${RUN_HOST_TARGETS[$i]}" ]]; then
            printf '%s' "$i"
            return 0
        fi
    done
    return 1
}

_mesh_add_selected_index() {
    local idx="$1"
    local alias="${RUN_HOST_ALIASES[$idx]}"
    local existing
    for existing in "${RUN_SELECTED_ALIASES[@]+"${RUN_SELECTED_ALIASES[@]}"}"; do
        [[ "$existing" == "$alias" ]] && return
    done
    RUN_SELECTED_ALIASES+=("$alias")
    RUN_SELECTED_TARGETS+=("${RUN_HOST_TARGETS[$idx]}")
}

_mesh_select_all_hosts() {
    RUN_SELECTED_ALIASES=()
    RUN_SELECTED_TARGETS=()
    local i
    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        _mesh_add_selected_index "$i"
    done
}

_mesh_alias_in_list() {
    local needle="$1"
    shift || true
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

_mesh_alias_is_configured() {
    local wanted="$1"
    local alias
    for alias in "${RUN_HOST_ALIASES[@]+"${RUN_HOST_ALIASES[@]}"}"; do
        [[ "$alias" == "$wanted" ]] && return 0
    done
    return 1
}

_mesh_preferred_alias_for_names() {
    local fallback="" name alias
    for name in "$@"; do
        [[ -n "$name" && "$name" != "null" ]] || continue
        alias="$(_mesh_alias_for_name "$name")"
        [[ -n "$alias" ]] || continue
        [[ -n "$fallback" ]] || fallback="$alias"
        if _mesh_alias_is_configured "$alias"; then
            printf '%s' "$alias"
            return 0
        fi
    done
    [[ -n "$fallback" ]] || return 1
    printf '%s' "$fallback"
}

_mesh_select_online_hosts() {
    RUN_SELECTED_ALIASES=()
    RUN_SELECTED_TARGETS=()
    local i
    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        if _mesh_alias_in_list "${RUN_HOST_ALIASES[$i]}" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
            _mesh_add_selected_index "$i"
        fi
    done
}

_mesh_command_available() {
    local cmd="$1"
    [[ -n "$cmd" ]] || return 1
    if [[ "$cmd" == */* ]]; then
        [[ -x "$cmd" ]]
    else
        command -v "$cmd" >/dev/null 2>&1
    fi
}

_mesh_has_ctty() {
    [[ -t 0 && -t 1 && -r /dev/tty && -w /dev/tty ]]
}

_mesh_select_from_spec() {
    local spec="$1"
    local token idx
    RUN_SELECTED_ALIASES=()
    RUN_SELECTED_TARGETS=()

    spec="${spec//,/ }"
    for token in $spec; do
        [[ -n "$token" ]] || continue
        if [[ "$token" =~ ^[0-9]+$ ]]; then
            idx=$(( token - 1 ))
            if (( idx < 0 || idx >= ${#RUN_HOST_ALIASES[@]} )); then
                _die "run: host number '$token' is outside the selector range"
            fi
        else
            idx="$(_mesh_find_host_index "$token")" || _die "run: unknown host '$token' (known: $(_mesh_known_hosts_display))"
        fi
        _mesh_add_selected_index "$idx"
    done
}

_mesh_online_count() {
    local count=0
    local alias
    for alias in "${RUN_HOST_ALIASES[@]+"${RUN_HOST_ALIASES[@]}"}"; do
        if _mesh_alias_in_list "$alias" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
            count=$((count + 1))
        fi
    done
    printf '%s' "$count"
}

_mesh_fzf_start_bind() {
    local count="$1"
    local i actions=""
    (( count > 0 )) || return 1
    for (( i=0; i<count; i++ )); do
        actions="${actions:+$actions+}select+down"
    done
    printf 'start:%s+first' "$actions"
}

_mesh_emit_fzf_rows() {
    local pass i alias target status local_mark self
    self="$(_mesh_self_alias)"
    for pass in online offline; do
        for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
            alias="${RUN_HOST_ALIASES[$i]}"
            target="${RUN_HOST_TARGETS[$i]}"
            status="offline"
            if _mesh_alias_in_list "$alias" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
                status="online"
            fi
            [[ "$status" == "$pass" ]] || continue
            local_mark=""
            [[ "$alias" == "$self" ]] && local_mark="local"
            printf '%s\t%s\t%s\tssh:%s\n' "$alias" "$status" "$local_mark" "$target"
        done
    done
}

_mesh_select_from_lines() {
    local lines="$1"
    local line alias idx
    RUN_SELECTED_ALIASES=()
    RUN_SELECTED_TARGETS=()

    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        alias="${line%%$'\t'*}"
        idx="$(_mesh_find_host_index "$alias")" || _die "run: selector returned unknown host '$alias'"
        _mesh_add_selected_index "$idx"
    done <<<"$lines"
}

_mesh_select_fzf() {
    local fzf_bin="${MESH_RUN_FZF:-fzf}"
    _mesh_command_available "$fzf_bin" || return 1
    if [[ "${MESH_RUN_SELECTOR:-}" != "fzf" ]] && ! _mesh_has_ctty; then
        return 1
    fi

    local rows selected rc bind
    rows="$(_mesh_emit_fzf_rows)"
    bind="$(_mesh_fzf_start_bind "$(_mesh_online_count)" 2>/dev/null || printf '')"

    if [[ -n "$bind" ]]; then
        selected=$(printf '%s\n' "$rows" | "$fzf_bin" \
            --multi \
            --sync \
            --no-sort \
            --delimiter=$'\t' \
            --with-nth='1,2,3,4' \
            --header='Tab marca/desmarca; Enter confirma' \
            --prompt='hosts> ' \
            --bind "$bind")
        rc=$?
    else
        selected=$(printf '%s\n' "$rows" | "$fzf_bin" \
            --multi \
            --no-sort \
            --delimiter=$'\t' \
            --with-nth='1,2,3,4' \
            --header='Tab marca/desmarca; Enter confirma' \
            --prompt='hosts> ')
        rc=$?
    fi

    case "$rc" in
        0)
            _mesh_select_from_lines "$selected"
            ;;
        1|130)
            RUN_SELECTED_ALIASES=()
            RUN_SELECTED_TARGETS=()
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

_mesh_select_whiptail() {
    local whiptail_bin="${MESH_RUN_WHIPTAIL:-whiptail}"
    _mesh_command_available "$whiptail_bin" || return 1
    if [[ "${MESH_RUN_SELECTOR:-}" != "whiptail" ]] && ! _mesh_has_ctty; then
        return 1
    fi

    local self i alias target status desc selected rc
    local items=()
    self="$(_mesh_self_alias)"

    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        alias="${RUN_HOST_ALIASES[$i]}"
        target="${RUN_HOST_TARGETS[$i]}"
        status="OFF"
        desc="offline ssh:$target"
        if _mesh_alias_in_list "$alias" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
            status="ON"
            desc="online ssh:$target"
        fi
        [[ "$alias" == "$self" ]] && desc="$desc local"
        items+=("$alias" "$desc" "$status")
    done

    selected=$("$whiptail_bin" \
        --separate-output \
        --title "mesh run" \
        --checklist "Selecione os hosts:" \
        20 78 10 \
        "${items[@]+"${items[@]}"}" \
        3>&1 1>&2 2>&3)
    rc=$?

    case "$rc" in
        0)
            _mesh_select_from_spec "$selected"
            ;;
        1|255)
            RUN_SELECTED_ALIASES=()
            RUN_SELECTED_TARGETS=()
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

_mesh_add_online_alias() {
    local alias="$1"
    local existing
    [[ -n "$alias" ]] || return
    for existing in "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; do
        [[ "$existing" == "$alias" ]] && return
    done
    RUN_ONLINE_ALIASES+=("$alias")
}

_mesh_self_alias() {
    local name alias self_fields self_host self_dns
    if [[ -n "${MESH_RUN_SELF_ALIAS:-}" ]]; then
        printf '%s' "$MESH_RUN_SELF_ALIAS"
        return
    fi
    if [[ -n "${MESH_HOST_ALIAS:-}" ]]; then
        printf '%s' "$MESH_HOST_ALIAS"
        return
    fi

    if command -v tailscale >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        self_fields=$(tailscale status --json 2>/dev/null | jq -r '[.Self.HostName // "", .Self.DNSName // ""] | @tsv' 2>/dev/null)
        if [[ -n "$self_fields" ]]; then
            IFS=$'\t' read -r self_host self_dns <<<"$self_fields"
            alias="$(_mesh_preferred_alias_for_names "$self_host" "$self_dns")" && {
                printf '%s' "$alias"
                return
            }
        fi
    fi

    name=$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf '')
    if [[ -n "$name" ]]; then
        alias="$(_mesh_preferred_alias_for_names "$name")" && {
            printf '%s' "$alias"
            return
        }
    fi
}

_mesh_collect_online_aliases() {
    RUN_ONLINE_ALIASES=()

    local item raw self alias peers peer_host peer_dns peer_key
    if [[ -n "${MESH_RUN_ONLINE_HOSTS:-}" ]]; then
        raw="${MESH_RUN_ONLINE_HOSTS//,/ }"
        for item in $raw; do
            _mesh_add_online_alias "$(_mesh_alias_for_name "$item")"
        done
        return
    fi

    self="$(_mesh_self_alias)"
    _mesh_add_online_alias "$self"

    if command -v tailscale >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
        peers=$(tailscale status --json 2>/dev/null | jq -r '
            .Peer // {} | to_entries[] |
            select(.value.Online == true) |
            [(.value.HostName // ""), (.value.DNSName // ""), .key] |
            @tsv
        ' 2>/dev/null)
        while IFS=$'\t' read -r peer_host peer_dns peer_key; do
            [[ -n "$peer_host$peer_dns$peer_key" ]] || continue
            alias="$(_mesh_preferred_alias_for_names "$peer_host" "$peer_dns" "$peer_key")" || continue
            _mesh_add_online_alias "$alias"
        done <<<"$peers"
    fi
}

_mesh_print_selector() {
    local self
    self="$(_mesh_self_alias)"
    local i alias target marker status local_mark
    printf 'mesh run: selecione hosts para executar o comando.\n' >&2
    printf 'Enter usa o padrão [online]; também aceita números, aliases, all, none.\n\n' >&2
    for (( i=0; i<${#RUN_HOST_ALIASES[@]}; i++ )); do
        alias="${RUN_HOST_ALIASES[$i]}"
        target="${RUN_HOST_TARGETS[$i]}"
        marker=" "
        status="offline"
        local_mark=""
        if _mesh_alias_in_list "$alias" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
            marker="x"
            status="online"
        fi
        [[ "$alias" == "$self" ]] && local_mark=", local"
        printf '  %2d. [%s] %-10s ssh:%-14s %s%s\n' "$((i+1))" "$marker" "$alias" "$target" "$status" "$local_mark" >&2
    done
    printf '\n' >&2
}

_mesh_select_text() {
    local default_display="" alias answer lowered
    _mesh_print_selector

    for alias in "${RUN_HOST_ALIASES[@]+"${RUN_HOST_ALIASES[@]}"}"; do
        if _mesh_alias_in_list "$alias" "${RUN_ONLINE_ALIASES[@]+"${RUN_ONLINE_ALIASES[@]}"}"; then
            default_display="${default_display:+$default_display,}$alias"
        fi
    done
    [[ -n "$default_display" ]] || default_display="none"

    answer="$(ask_line "Hosts [$default_display]")"

    lowered="$(_lower "$answer")"
    case "$lowered" in
        "")
            _mesh_select_online_hosts
            ;;
        all)
            _mesh_select_all_hosts
            ;;
        none|q|quit|cancel)
            RUN_SELECTED_ALIASES=()
            RUN_SELECTED_TARGETS=()
            ;;
        *)
            _mesh_select_from_spec "$answer"
            ;;
    esac
}

_mesh_select_interactive() {
    case "${MESH_RUN_SELECTOR:-auto}" in
        fzf)
            _mesh_select_fzf || _mesh_select_text
            ;;
        whiptail)
            _mesh_select_whiptail || _mesh_select_text
            ;;
        text)
            _mesh_select_text
            ;;
        auto|"")
            _mesh_select_fzf || _mesh_select_whiptail || _mesh_select_text
            ;;
        *)
            _die "run: unknown selector '${MESH_RUN_SELECTOR}' (expected auto | fzf | whiptail | text)"
            ;;
    esac
}

_mesh_quote_args() {
    local out="" q arg
    for arg in "$@"; do
        printf -v q '%q' "$arg"
        out="${out:+$out }$q"
    done
    printf '%s' "$out"
}

# A fan-out subcommand that must NEVER block on one host's interactive pause —
# `syncthing pair` would otherwise hang waiting for a Tier-0 device approve.
# Forcing non-interactive makes a pending approval defer (already handled by the
# pair runner) so the sweep continues across every host.
_run_force_noninteractive() { [[ "${1:-}" == "syncthing" ]]; }

_mesh_remote_command() {
    local quoted env_prefix=""
    quoted="$(_mesh_quote_args "$@")"
    if _run_force_noninteractive "${1:-}"; then
        env_prefix="NON_INTERACTIVE=1; export NON_INTERACTIVE; "
    fi
    printf "%sDEV_BOOTSTRAP_TMUX_AUTO_MAIN=0; export DEV_BOOTSTRAP_TMUX_AUTO_MAIN; if command -v mesh >/dev/null 2>&1; then mesh %s; elif [ -x \"\$HOME/.local/bin/mesh\" ]; then \"\$HOME/.local/bin/mesh\" %s; else echo \"mesh: remote mesh command not found\" >&2; exit 127; fi" "$env_prefix" "$quoted" "$quoted"
}

_mesh_command_display() {
    printf 'mesh %s' "$(_mesh_quote_args "$@")"
}

_run_update_args_are_interactive() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            -i|--interactive) return 0 ;;
        esac
    done
    return 1
}

_print_run_help() {
    cat <<'EOF'
Usage:
  mesh run [--hosts A,B | --online | --all] [--dry-run] <subcommand> [args...]

Default with no host flag opens a multi-select when fzf/whiptail is available.
Online configured hosts are preselected; Tab toggles, Enter confirms. A text
prompt is used only as fallback when no interactive selector is available.

Supported subcommands: status, snap, update, syncthing pair|status.

Examples:
  mesh run update -f
  mesh run --hosts mac,crc update -f
  mesh run --online snap --quiet
  mesh run --all status --write
  mesh run --all syncthing pair          Reconcile every host from one place
EOF
}

sub_run() {
    local mode="select"
    local host_spec=""
    local dry_run=0
    local value

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                _print_run_help
                return 0
                ;;
            --hosts)
                [[ "$mode" == "select" ]] || _die "run: choose only one host selector (--hosts, --online, --all)"
                shift
                value="${1:-}"
                [[ -n "$value" && "$value" != -* ]] || _die "run: --hosts requires a comma-separated host list"
                host_spec="$value"
                mode="hosts"
                shift
                ;;
            --hosts=*)
                [[ "$mode" == "select" ]] || _die "run: choose only one host selector (--hosts, --online, --all)"
                host_spec="${1#*=}"
                [[ -n "$host_spec" ]] || _die "run: --hosts requires a comma-separated host list"
                mode="hosts"
                shift
                ;;
            --online)
                [[ "$mode" == "select" ]] || _die "run: choose only one host selector (--hosts, --online, --all)"
                mode="online"
                shift
                ;;
            --all)
                [[ "$mode" == "select" ]] || _die "run: choose only one host selector (--hosts, --online, --all)"
                mode="all"
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            --)
                shift
                break
                ;;
            --*|-*)
                _die "run: unknown flag '$1'"
                ;;
            *)
                break
                ;;
        esac
    done

    (( $# > 0 )) || _die "run: missing mesh subcommand (status | snap | update | syncthing pair|status)"
    local mesh_subcommand="$1"
    shift
    local mesh_args=("$@")

    case "$mesh_subcommand" in
        status|snap|update)
            ;;
        syncthing)
            # Fan out only the safe, idempotent verbs — never password (rotates a
            # secret), init-hub or topology (hub-local / mesh-wide mutations).
            case "${mesh_args[0]:-}" in
                pair|status) ;;
                *) _die "run: only \`syncthing pair\` and \`syncthing status\` can fan out (got '${mesh_args[0]:-}')" ;;
            esac
            ;;
        run)
            _die "run: nested 'mesh run' is not supported"
            ;;
        *)
            _die "run: unsupported mesh subcommand '$mesh_subcommand' (supported: status, snap, update, syncthing pair|status)"
            ;;
    esac

    if [[ "$mesh_subcommand" == "update" ]] && _run_update_args_are_interactive "${mesh_args[@]+"${mesh_args[@]}"}"; then
        _die "run: update -i/--interactive is not supported across hosts; run it on one host at a time"
    fi

    _mesh_load_run_hosts
    _mesh_collect_online_aliases

    case "$mode" in
        select) _mesh_select_interactive ;;
        hosts)  _mesh_select_from_spec "$host_spec" ;;
        online) _mesh_select_online_hosts ;;
        all)    _mesh_select_all_hosts ;;
    esac

    if (( ${#RUN_SELECTED_ALIASES[@]} == 0 )); then
        printf 'mesh run: no hosts selected\n' >&2
        return 0
    fi

    local self_alias
    self_alias="$(_mesh_self_alias)"
    local display
    display="$(_mesh_command_display "$mesh_subcommand" "${mesh_args[@]+"${mesh_args[@]}"}")"
    printf 'mesh run: %s\n' "$display" >&2

    local failed=0
    local i alias target rc remote_cmd
    for (( i=0; i<${#RUN_SELECTED_ALIASES[@]}; i++ )); do
        alias="${RUN_SELECTED_ALIASES[$i]}"
        target="${RUN_SELECTED_TARGETS[$i]}"

        if [[ "$alias" == "$self_alias" ]]; then
            if (( dry_run )); then
                printf 'DRY-RUN: %s (local): %s\n' "$alias" "$display" >&2
                continue
            fi
            printf '\n== %s (local) ==\n' "$alias" >&2
            if _run_force_noninteractive "$mesh_subcommand"; then
                NON_INTERACTIVE=1 DEV_BOOTSTRAP_TMUX_AUTO_MAIN=0 bash "${BASH_SOURCE[0]}" "$mesh_subcommand" "${mesh_args[@]+"${mesh_args[@]}"}"
            else
                DEV_BOOTSTRAP_TMUX_AUTO_MAIN=0 bash "${BASH_SOURCE[0]}" "$mesh_subcommand" "${mesh_args[@]+"${mesh_args[@]}"}"
            fi
            rc=$?
        else
            if (( dry_run )); then
                printf 'DRY-RUN: %s (ssh %s): %s\n' "$alias" "$target" "$display" >&2
                continue
            fi
            printf '\n== %s (ssh %s) ==\n' "$alias" "$target" >&2
            remote_cmd="$(_mesh_remote_command "$mesh_subcommand" "${mesh_args[@]+"${mesh_args[@]}"}")"
            "${MESH_RUN_SSH:-ssh}" -tt "$target" "$remote_cmd"
            rc=$?
        fi

        if (( rc != 0 )); then
            failed=1
            printf 'mesh run: %s failed (rc=%d)\n' "$alias" "$rc" >&2
        fi
    done

    return "$failed"
}

sub_init() {
    local lib
    lib="$(_resolve_companion "lib/init.sh")"
    [[ -n "$lib" ]] || _die "lib/init.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$lib" "$@"
}

sub_template_check() {
    local lib
    lib="$(_resolve_companion "lib/template-check.sh")"
    [[ -n "$lib" ]] || _die "lib/template-check.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$lib" "$@"
}

sub_lint() {
    local lib
    lib="$(_resolve_companion "lib/lint.sh")"
    [[ -n "$lib" ]] || _die "lib/lint.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$lib" "$@"
}

sub_catalog() {
    local action="${1:-}"
    case "$action" in
        generate)
            shift
            local lib
            lib="$(_resolve_companion "lib/catalog.sh")"
            [[ -n "$lib" ]] || _die "lib/catalog.sh not found (set \$MESH_HOME or check installation)"
            exec bash "$lib" "$@"
            ;;
        ""|-h|--help)
            cat <<'EOF'
Usage: mesh catalog generate

Regenerates .catalog/ with 4 derived files + index:
  resources.txt   files under topics/*/resources/
  opt-ins.txt     INCLUDE_* env-var toggles
  cli.txt         mesh subcommands (parsed from bin/mesh)
  drivers.txt     installer drivers in scripts/lib/installers/
  README.md       index + pointer to docs/catalog/behaviors.md

Output is byte-stable; CI can diff two runs to detect drift.
EOF
            ;;
        *)
            _die "catalog: unknown action '$action' (try: mesh catalog generate)"
            ;;
    esac
}

sub_personal_clone() {
    local lib
    lib="$(_resolve_companion "lib/personal-clone.sh")"
    [[ -n "$lib" ]] || _die "lib/personal-clone.sh not found (set \$MESH_HOME or check installation)"
    exec bash "$lib" "$@"
}

