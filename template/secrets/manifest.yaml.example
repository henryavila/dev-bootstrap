# Secrets manifest — declarative registry of your replicated personal secrets.
# This file is CLEARTEXT (it holds NO secrets, only declarations) and is read by
# `mesh secret`. Prefer the wizard (`mesh secret add`) over hand-editing; the
# schema + the fail-closed pre-commit guard catch mistakes either way.
#
# Two tiers (see docs/2026-06-02-secrets-layer-spec.md):
#   tier 1 (login)  — a native login screen generates the token; nothing stored.
#   tier 2 (file | env-token) — manually-created / purchased; git-crypt-encrypted
#                     under secrets/ and replicated to every machine you unlock.
#
# Get started:
#   mesh secret init            # first machine: install+init git-crypt, save key
#   mesh secret add             # guided: add an integration
#   mesh secret unlock <key>    # a new machine: decrypt, then `mesh install`
#
# Example entries (delete these — they are illustrative):
#
#   composer-auth:                       # tier 2, file
#     tier: 2
#     type: file
#     source: secrets/composer/auth.json # git-crypt-encrypted in this repo
#     dest_resolver: composer-home       # composer config --global home (+fallbacks)
#     dest_file: auth.json
#     perms: "0600"
#     # machines: [mac, ultron]          # optional scope; omit = all machines
#
#   anthropic:                           # tier 2, env-token
#     tier: 2
#     type: env-token
#     key: ANTHROPIC_API_KEY             # deployed to secrets.env on each machine
#
#   github:                              # tier 1, login (no secret stored)
#     tier: 1
#     type: login
#     check: gh auth status
#     login: gh auth login

version: 1
integrations:
