{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/henryavila/mesh-workstation/schema/manifest.schema.json",
  "title": "mesh manifest.yaml v2",
  "description": "Hierarchical topic → bundles → items + options schema. Shape-level validation for editors (yaml-language-server) and the TS reader (manifest-reader.ts). The authoritative enforcer of cross-reference rules (cycles, requires_bundles targets, when:/derive_from resolution, rules §8.9-16) is scripts/lib/validate-manifest.sh — JSON Schema cannot express those.",
  "type": "object",
  "required": ["topic", "bundles"],
  "additionalProperties": false,
  "properties": {
    "topic": { "$ref": "#/$defs/topic" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundle" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "required": ["label", "order"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "required": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 },
        "description": { "type": "string" }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["name", "label", "desc", "items"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/kebab" },
        "label": { "type": "string", "minLength": 1 },
        "desc": { "type": "string", "minLength": 1 },
        "platforms": { "$ref": "#/$defs/platforms" },
        "required": { "type": "boolean" },
        "default_selected": { "type": "boolean" },
        "requires_bundles": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" }
        },
        "icon_name": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/kebab" },
        "type": {
          "enum": ["custom", "brew-formula", "brew-cask", "apt", "npm-global", "npx", "cargo", "pip", "git-clone", "github-release", "go-install", "deploy"]
        },
        "spec": { "type": "string" },
        "script": { "type": "string" },
        "check": { "type": "string" },
        "platforms": { "$ref": "#/$defs/platforms" },
        "when": { "type": "string" },
        "idempotent": { "type": "boolean" },
        "uninstall_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
        "post": { "type": "string" },
        "rollback": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "custom" } } },
          "then": { "required": ["script"] },
          "else": { "required": ["spec"] }
        }
      ]
    },
    "option": {
      "type": "object",
      "required": ["name", "type", "label", "env"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/kebab" },
        "type": { "enum": ["multiselect", "select", "toggle", "text", "secret"] },
        "label": { "type": "string", "minLength": 1 },
        "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "default": {},
        "default_from": { "type": "string" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "derive_from": { "type": "string" },
        "source": { "type": "string" },
        "required_min": { "type": "integer", "minimum": 0 }
      }
    },
    "choice": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "default": { "type": "boolean" }
      }
    },
    "platforms": {
      "type": "array",
      "items": { "enum": ["mac", "wsl", "linux"] }
    },
    "kebab": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
  }
}
